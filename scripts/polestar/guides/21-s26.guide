  accept 5217 "Return to Chillwind Camp" @37.3,56.8
  accept 5222 "Target: Writhing Haunt" @43.0,84.5
  accept 5219 "Target: Dalson's Tears" @43.0,84.5
  accept 5225 "Target: Gahrron's Withering" @43.0,84.5
